#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground"
    {
        double size = 2
        float3[] extent = [(-1, -1, -1), (1, 1, 1)]
        double3 xformOp:translate = (0, -0.15, 0)
        float3 xformOp:scale = (5, 0.15, 5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.22, 0.25, 0.30)]
    }
    def Cube "BlueCube"
    {
        double size = 2
        float3[] extent = [(-1, -1, -1), (1, 1, 1)]
        # Height 2: lowered by 0.5 to intersect the floor.
        double3 xformOp:translate = (-1.8, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.04, 0.35, 0.78)]
    }
    def Sphere "OrangeSphere"
    {
        double radius = 1.2
        float3[] extent = [(-1.2, -1.2, -1.2), (1.2, 1.2, 1.2)]
        # Height 2.4: lowered by 0.6 to intersect the floor.
        double3 xformOp:translate = (1.6, 0.6, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.95, 0.32, 0.07)]
    }
    def Cylinder "GreenCylinder"
    {
        double radius = 0.65
        double height = 3
        uniform token axis = "Y"
        float3[] extent = [(-0.65, -1.5, -0.65), (0.65, 1.5, 0.65)]
        # Height 3: lowered by 0.75 to intersect the floor.
        double3 xformOp:translate = (0.3, 0.75, -2.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.12, 0.65, 0.40)]
    }
}
